    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
