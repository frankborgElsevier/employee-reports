{
  "name": "employee-reports",
  "version": "0.1.0",
  "private": true,
  "description": "WorkDay reporting dashboard app: SQLite data foundation and dashboards.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
